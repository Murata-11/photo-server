{
  "name": "@photo-server/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:coverage": "vitest run --coverage --config ../../vitest.config.ts",
    "build": "tsc -p tsconfig.build.json && cp src/schema.sql dist/schema.sql && cp -r src/migrations dist/",
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/index.ts",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "migrate": "node --env-file-if-exists=../../.env --import tsx src/migrate.ts",
    "test:integration": "vitest run src/integration.test.ts",
    "build:native-sharp": "node scripts/build-native-sharp.mjs",
    "check:heic": "node scripts/check-heic.mjs"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "exifr": "7.1.3",
    "hono": "4.13.17",
    "pg": "8.23.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/pg": "8.18.0",
    "tsx": "4.23.15"
  }
}
