{
  "name": "photo-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "check:structure": "node scripts/check-structure.mjs",
    "typecheck": "npm run check:structure && tsc --noEmit",
    "test:coverage": "vitest run --coverage",
    "build": "npm run check:structure && tsc -p tsconfig.build.json",
    "check:unused": "knip",
    "dod-check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run check:unused && npm audit --audit-level=high"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "4.1.12",
    "@vitest/eslint-plugin": "1.6.28",
    "eslint": "10.14.0",
    "knip": "5.88.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "4.1.12"
  }
}
