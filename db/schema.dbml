Project photo_server {
  database_type: 'PostgreSQL'
  Note: 'ADR 0003の初期実装。実行SQLはapps/backend/src/schema.sql。既存の未適用レビュー案を具体化。'
}
Table albums {
  name text [pk, not null, note: '1〜100文字。名前で一意。空アルバムも保持する。']
}
Table photos {
  id uuid [pk, not null]
  filename text [not null, note: '表示専用。サーバー生成UUIDを保存キーに使用。']
  media_type text [not null]
  size_bytes bigint [not null, check: `size_bytes > 0`]
  sha256 char(64) [not null]
  uploaded_by text [not null, note: '認証済みTailscaleログイン名。権限差を作らない。']
  created_at timestamptz [not null, default: `now()`]
  favorite boolean [not null, default: false]
  deleted boolean [not null, default: false, note: 'ゴミ箱。期限なし、元画像取得・復元可能。物理消去なし。']
  album text
  metadata jsonb [not null, note: 'EXIF解析状態、撮影現地日時、既知UTCオフセット、GPS。API非公開。未設定を推測で補わない。']
  indexes {
    (created_at, id) [name: 'photos_order']
  }
}
Ref: photos.album > albums.name [delete: restrict]
