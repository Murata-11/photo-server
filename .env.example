# Copy to .env (gitignored). Use a unique local password and URL-encode it in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-local-password
# Docker app: the same password, URL-encoded (encode @, :, /, %, etc.).
POSTGRES_PASSWORD_URLENCODED=replace-with-local-password
# Docker app: existing host folder. Windows example: D:/Photos/photo-server
PHOTO_STORAGE_PATH=./work/photo-data
DATABASE_URL=postgresql://photo:replace-with-local-password@127.0.0.1:5432/photo
PHOTO_DATA_DIR=../../work/photo-data
APP_ORIGIN=https://your-server.your-tailnet.ts.net
ALLOWED_USERS=first@example.com,second@example.com
PORT=3000
# Local fixture UI ONLY; unset for Tailscale. Enables a fixed identity on loopback.
# DEV_USER=first@example.com
